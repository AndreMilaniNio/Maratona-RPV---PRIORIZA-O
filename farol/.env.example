# Copie para .env. Nenhum valor real/sensível deve ser versionado.

# PostgreSQL (docker-compose)
POSTGRES_DB=farol
POSTGRES_USER=farol
POSTGRES_PASSWORD=troque-esta-senha

# Chave do JWT: no mínimo 32 caracteres aleatórios (ex.: openssl rand -base64 48)
JWT_CHAVE=troque-por-uma-chave-aleatoria-com-mais-de-32-caracteres

# Administrador inicial: criado uma única vez, na primeira subida, se ambos estiverem definidos.
# Troque a senha após o primeiro acesso e remova estas variáveis em seguida.
FAROL_ADMIN_EMAIL=
FAROL_ADMIN_SENHA=

# Conjunto demonstrativo (base fictícia). Desligue em ambientes reais.
FAROL_DEMO=true
# Senha dos usuários demonstrativos (*@farol.demo). Mínimo de 10 caracteres.
FAROL_DEMO_SENHA=Farol@Demo2026

# Integrações opcionais (vazias = desabilitadas; nada é presumido)
# Serviço de rotas compatível com OSRM, ex.: http://osrm:5000
FAROL_ROTEAMENTO_URL=
# Provedor de CEP: Demonstrativo (base local) ou Http (com URL contendo {cep})
FAROL_CEP_PROVEDOR=Demonstrativo
FAROL_CEP_URL=

# Frontend
VITE_API_URL=http://localhost:5080

# Testes de integração (banco recriado a cada execução — use um banco descartável)
FAROL_TEST_CONNECTION=Host=localhost;Port=5432;Database=farol_test;Username=farol;Password=troque-esta-senha
